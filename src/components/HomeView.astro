---
import MirrorCard from "./MirrorCard.astro";
import SeoContent from "./SeoContent.astro";
import {
  HOME_URL,
  DOMAINS,
  APP,
  formatCheckedAtTime,
  statusFor,
} from "../data/config";
import { LEAGUES, COMPETITORS, FAQS } from "../data/seo";

let snapshot: import("../data/config").StatusSnapshot | null = null;
try {
  const mod = await import("../data/status.json");
  snapshot = (mod.default ?? mod) as import("../data/config").StatusSnapshot;
} catch {
  snapshot = null;
}

const updated = formatCheckedAtTime(snapshot?.updatedAt);

const liveCards = DOMAINS.map((d) => {
  const s = statusFor(snapshot, d.url);
  return {
    ...d,
    status: s.status,
    httpStatus: s.httpStatus,
    ms: s.ms,
    checkedAt: snapshot?.updatedAt,
  };
}).filter((c) => c.status === "live");

const primary = liveCards[0] ?? null;
const backups = liveCards.slice(1);

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQS.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};

const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "GKStreams sports link topics",
  itemListElement: [
    ...LEAGUES.map((l, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: l.h2,
      url: `${HOME_URL}#${l.id}`,
    })),
    ...COMPETITORS.map((c, i) => ({
      "@type": "ListItem",
      position: LEAGUES.length + i + 1,
      name: `${c.name} and GKStreams`,
      url: `${HOME_URL}#${c.id}`,
    })),
  ],
};
---

<section class="hero">
  <div class="hero__head">
    <h1>GKStreams: The best free site for sports lover</h1>
    <p class="hero-meta">
      Links checked every 15 minutes
      <span class="hero-meta__sep" aria-hidden="true">·</span>
      <span class="updated-at" data-updated-at data-updated-prefix="Updated "
        >Updated {updated}</span
      >
    </p>
  </div>

  <div class="hero__actions">
    <img
      class="hero__logo"
      src="/icons/hero.webp"
      width="80"
      height="80"
      alt=""
    />
    <div class="hero__ctas">
      <a
        class="hero-cta"
        data-primary-mirror
        href={primary?.url}
        target="_blank"
        rel="noopener noreferrer"
        hidden={!primary}
      >
        Visit Full Site
      </a>
      <a
        class="hero-cta hero-cta--app"
        href={APP.downloadUrl}
        target="_blank"
        rel="nofollow noopener noreferrer"
      >
        <svg
          class="hero-cta__icon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M6 18c0 .55.45 1 1 1h1v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h2v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h1c.55 0 1-.45 1-1V8H6v10zM3.5 8C2.67 8 2 8.67 2 9.5v7c0 .83.67 1.5 1.5 1.5S5 17.33 5 16.5v-7C5 8.67 4.33 8 3.5 8zm17 0c-.83 0-1.5.67-1.5 1.5v7c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-7c0-.83-.67-1.5-1.5-1.5zm-4.97-5.84l1.3-1.3c.2-.2.2-.51 0-.71-.2-.2-.51-.2-.71 0l-1.48 1.48A5.84 5.84 0 0 0 12 1c-.96 0-1.86.23-2.66.67L7.85.19c-.2-.2-.51-.2-.71 0-.2.2-.2.51 0 .71l1.31 1.31A5.98 5.98 0 0 0 6 7h12c0-2.02-1-3.8-2.5-5.16zM10 5H9V4h1v1zm5 0h-1V4h1v1z"
          ></path>
        </svg>
        <span class="hero-cta__text">
          <span class="hero-cta__label">Download App</span>
          <span class="hero-cta__tagline">{APP.tagline}</span>
        </span>
      </a>
    </div>
  </div>

  <div class="backup" id="mirrors" data-backup hidden={backups.length === 0}>
    <h2 class="backup__title">Available backup mirrors</h2>
    <div class="mirror-list" data-mirror-grid>
      {
        backups.map((card) => (
          <MirrorCard
            url={card.url}
            label={card.label}
            status={card.status}
          />
        ))
      }
    </div>
  </div>

  <div class="empty-state" data-empty-state hidden={liveCards.length > 0}>
    <h2>No mirrors online</h2>
    <p>GKStreams re-checks shortly. Please try again soon.</p>
    <p class="updated-at" data-updated-at data-updated-prefix="Updated "
      >Updated {updated}</p
    >
  </div>
</section>

<div class="container article-wrap">
  <SeoContent mirrorCount={liveCards.length} />
</div>

<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />

---
interface Props {
  url: string;
  label: string;
  status: "live" | "down" | "unknown";
}

const { url, status } = Astro.props;

const host = (() => {
  try {
    return new URL(url).host;
  } catch {
    return url;
  }
})();
---

<a
  class="mirror-card is-live"
  href={url}
  data-mirror-card
  data-url={url}
  target="_blank"
  rel="noopener noreferrer"
  hidden={status !== "live"}
>
  <p class="mirror-card__host">{host}</p>
  <span class="badge badge--live" data-status-badge role="status" aria-label="Status: Online">
    <span class="badge__dot" aria-hidden="true"></span>
    Online
  </span>
</a>

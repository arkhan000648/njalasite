---
interface Props {
  url: string;
  label: string;
  status: "live" | "down" | "unknown";
  httpStatus?: number;
  ms?: number;
  checkedAt?: string;
}

const { url, label, status, httpStatus, ms, checkedAt } = Astro.props;

const host = (() => {
  try {
    return new URL(url).host;
  } catch {
    return url;
  }
})();

const metaParts: string[] = [];
if (ms != null) metaParts.push(`${ms} ms`);
if (httpStatus) metaParts.push(`HTTP ${httpStatus}`);
if (checkedAt && checkedAt !== new Date(0).toISOString()) metaParts.push(`checked ${checkedAt}`);
const meta = metaParts.join(" · ") || "Verified online";
---

<article
  class="mirror-card is-live"
  data-mirror-card
  data-url={url}
  hidden={status !== "live"}
>
  <div>
    <p class="mirror-card__label">{label}</p>
    <p class="mirror-card__host">{host}</p>
  </div>

  <div class="mirror-card__actions">
    <span class="badge badge--live" data-status-badge role="status" aria-label="Status: Online">
      <span class="badge__dot" aria-hidden="true"></span>
      Online
    </span>
    <a
      class="btn btn--primary"
      href={url}
      data-visit
      target="_blank"
      rel="noopener noreferrer"
    >
      Open mirror
      <span aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="mirror-card__meta" data-status-meta>{meta}</div>
</article>

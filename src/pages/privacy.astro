---
import Base from "../layouts/Base.astro";
import { SITE } from "../data/config";

const title = `Privacy Policy — ${SITE.name}`;
const description =
  "How the GKStreams mirror directory handles logs, cookies, and personal data. Minimal data, no accounts, no ad trackers by default.";
---

<Base path="/privacy/" title={title} description={description}>
  <section class="section">
    <div class="container prose">
      <h1>Privacy Policy</h1>
      <p>Last updated: {new Date().toISOString().slice(0, 10)}</p>

      <p>
        This policy explains what limited information may be processed when you visit{" "}
        <strong>{SITE.name}</strong>’s informational mirror directory.
      </p>

      <h2>What we collect</h2>
      <ul>
        <li>
          <strong>No accounts.</strong> We do not require registration and do not store
          passwords or payment data.
        </li>
        <li>
          <strong>No marketing cookies by default.</strong> The site is designed to work
          without advertising trackers.
        </li>
        <li>
          <strong>Standard server logs.</strong> GitHub Pages / its CDN may temporarily
          process IP addresses, user-agent, and request times for delivery, security,
          and abuse prevention, subject to GitHub’s own policies.
        </li>
        <li>
          <strong>Status checks.</strong> Automated probes request the homepage of listed
          domains to determine availability. That does not involve your personal data.
        </li>
      </ul>

      <h2>Local storage / status script</h2>
      <p>
        A small script may fetch <code>/status.json</code> to refresh LIVE/DOWN badges.
        It does not intentionally collect personal information. Any preference storage,
        if added later, will be documented here.
      </p>

      <h2>Third-party links</h2>
      <p>
        Outbound mirror links lead to sites we do not control. Their privacy practices
        are governed by their own policies.
      </p>

      <h2>Children</h2>
      <p>
        This informational site is not directed at children under 13, and we do not
        knowingly collect personal data from children.
      </p>

      <h2>Changes</h2>
      <p>
        We may update this policy. The date above reflects the latest revision. material
        changes will be posted on this page.
      </p>

      <h2>Contact</h2>
      <p>
        Questions: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>

      <p>
        <a class="btn btn--ghost" href="/">← Back to mirror list</a>
      </p>
    </div>
  </section>
</Base>

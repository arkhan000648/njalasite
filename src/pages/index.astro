---
import Base from "../layouts/Base.astro";
import MirrorCard from "../components/MirrorCard.astro";
import SeoContent from "../components/SeoContent.astro";
import { SITE, DOMAINS, formatCheckedAtTime, statusFor } from "../data/config";
import { LEAGUES, COMPETITORS, FAQS } from "../data/seo";

let snapshot: import("../data/config").StatusSnapshot | null = null;
try {
  const mod = await import("../data/status.json");
  snapshot = (mod.default ?? mod) as import("../data/config").StatusSnapshot;
} catch {
  snapshot = null;
}

const updated = formatCheckedAtTime(snapshot?.updatedAt);

const liveCards = DOMAINS.map((d) => {
  const s = statusFor(snapshot, d.url);
  return {
    ...d,
    status: s.status,
    httpStatus: s.httpStatus,
    ms: s.ms,
    checkedAt: snapshot?.updatedAt,
  };
}).filter((c) => c.status === "live");

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQS.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};

const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "GKStreams sports link topics",
  itemListElement: [
    ...LEAGUES.map((l, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: l.h2,
      url: `${SITE.url}/#${l.id}`,
    })),
    ...COMPETITORS.map((c, i) => ({
      "@type": "ListItem",
      position: LEAGUES.length + i + 1,
      name: `${c.name} and GKStreams`,
      url: `${SITE.url}/#${c.id}`,
    })),
  ],
};
---

<Base path="/" title={SITE.title} description={SITE.description}>
  <section class="intro">
    <div class="intro__wrap">
      <img
        class="intro__logo"
        src="/icons/favicon.svg"
        width="72"
        height="72"
        alt="GKStreams"
      />
      <h1>GKStreams: The best free site for sports lover</h1>
      <p class="intro-meta">
        <strong data-live-count>{liveCards.length}</strong> mirrors online
        <span class="intro-meta__sep" aria-hidden="true">·</span>
        <span class="updated-at" data-updated-at data-updated-prefix="Updated "
          >Updated {updated}</span
        >
      </p>
    </div>
  </section>

  <div class="mirrors-wrap" id="mirrors">
    <div class="mirror-list" data-mirror-grid hidden={liveCards.length === 0}>
      {
        liveCards.map((card) => (
          <MirrorCard
            url={card.url}
            label={card.label}
            status={card.status}
            httpStatus={card.httpStatus}
            ms={card.ms}
            checkedAt={card.checkedAt}
          />
        ))
      }
    </div>

    <div class="empty-state" data-empty-state hidden={liveCards.length > 0}>
      <h2>No mirrors online</h2>
      <p>GKStreams re-checks shortly. Please try again soon.</p>
      <p class="updated-at" data-updated-at data-updated-prefix="Updated "
        >Updated {updated}</p
      >
    </div>
  </div>

  <div class="container article-wrap">
    <SeoContent mirrorCount={liveCards.length} />
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
</Base>

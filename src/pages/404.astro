---
import { HOME_PATH, HOME_URL } from "../data/config";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GKStreams</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={HOME_URL} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta http-equiv="refresh" content={`0; url=${HOME_PATH}`} />
    <script is:inline define:vars={{ home: HOME_PATH }}>
      location.replace(home);
    </script>
  </head>
  <body>
    <p>
      Page not found.
      <a href={HOME_PATH}>Go to the GKStreams homepage</a>.
    </p>
  </body>
</html>

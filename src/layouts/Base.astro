---
import { SITE, formatCheckedAtTime } from "../data/config";
import { NAV_ITEMS } from "../data/seo";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  path = "/",
} = Astro.props;

const canonical = new URL(path, SITE.url).toString();
const logoUrl = new URL("/icons/logo-512.png", SITE.url).toString();

let statusSnapshot: import("../data/config").StatusSnapshot | null = null;
try {
  const mod = await import("../data/status.json");
  statusSnapshot = (mod.default ?? mod) as import("../data/config").StatusSnapshot;
} catch {
  statusSnapshot = null;
}

const updated = formatCheckedAtTime(statusSnapshot?.updatedAt);

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
      logo: {
        "@type": "ImageObject",
        "@id": `${SITE.url}/#logo`,
        url: logoUrl,
        width: 512,
        height: 512,
        caption: SITE.name,
      },
    },
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      name: SITE.name,
      url: SITE.url,
      description: SITE.description,
      publisher: { "@id": `${SITE.url}/#organization` },
      inLanguage: "en",
    },
    {
      "@type": "WebPage",
      "@id": `${SITE.url}/#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { "@id": `${SITE.url}/#website` },
      primaryImageOfPage: { "@id": `${SITE.url}/#logo` },
      inLanguage: "en",
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={logoUrl} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content={SITE.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={logoUrl} />
    <meta name="twitter:image:alt" content={SITE.name} />

    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="topbar">
      <div class="container topbar__inner">
        <a class="brand" href="/">GK<span>Streams</span></a>
        <button
          class="nav-toggle"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="site-nav"
          data-nav-toggle
        >
          <span class="nav-toggle__bar" aria-hidden="true"></span>
          <span class="nav-toggle__bar" aria-hidden="true"></span>
          <span class="nav-toggle__bar" aria-hidden="true"></span>
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Primary" data-site-nav>
          {
            NAV_ITEMS.map((item) => (
              <a href={item.href}>
                {item.icon === "download" && (
                  <span class="nav-icon" aria-hidden="true">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.25"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M12 3v12" />
                      <path d="m7 12 5 5 5-5" />
                      <path d="M5 21h14" />
                    </svg>
                  </span>
                )}
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>{SITE.footerDisclaimer}</p>
        <p class="site-footer__copy">
          © {new Date().getFullYear()} {SITE.name} ·
          <span class="updated-at" data-updated-at data-updated-prefix="Updated "
            >Updated {updated}</span
          >
        </p>
      </div>
    </footer>

    <script is:inline type="application/json" id="status-data" set:html={JSON.stringify({
      updatedAt: statusSnapshot?.updatedAt ?? null,
      domains: (statusSnapshot?.domains ?? []).filter((d) => d.status === "live"),
    })} />

    <script is:inline>
      (function () {
        var toggle = document.querySelector("[data-nav-toggle]");
        var nav = document.querySelector("[data-site-nav]");
        if (toggle && nav) {
          toggle.addEventListener("click", function () {
            var open = nav.classList.toggle("is-open");
            toggle.setAttribute("aria-expanded", open ? "true" : "false");
            toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
          });
          nav.querySelectorAll("a").forEach(function (link) {
            link.addEventListener("click", function () {
              nav.classList.remove("is-open");
              toggle.setAttribute("aria-expanded", "false");
              toggle.setAttribute("aria-label", "Open menu");
            });
          });
        }

        var grid = document.querySelector("[data-mirror-grid]");
        var empty = document.querySelector("[data-empty-state]");
        var primary = document.querySelector("[data-primary-mirror]");
        var backup = document.querySelector("[data-backup]");

        function formatTime(iso) {
          if (!iso) return "";
          var t = Date.parse(iso);
          if (Number.isNaN(t) || t === 0) return "";
          try {
            return new Date(t).toLocaleString("en-US", {
              hour: "numeric",
              minute: "2-digit",
              hour12: true,
            });
          } catch (e) {
            return new Date(t).toUTCString();
          }
        }

        function applyStatus(data) {
          if (!data || !Array.isArray(data.domains)) return;
          var map = {};
          data.domains.forEach(function (d) {
            if (d.status && d.status !== "live") return;
            map[(d.url || "").replace(/\/+$/, "").toLowerCase()] = d;
          });

          var live = 0;
          var firstLive = null;
          var checkedLabel = formatTime(data.updatedAt);
          var cards = grid ? grid.querySelectorAll("[data-mirror-card]") : [];

          cards.forEach(function (card) {
            var url = (card.getAttribute("data-url") || "").replace(/\/+$/, "").toLowerCase();
            var entry = map[url];
            if (entry) {
              live++;
              if (!firstLive) firstLive = entry.url;
              card.hidden = false;
              var badge = card.querySelector("[data-status-badge]");
              if (badge) {
                badge.className = "badge badge--live";
                badge.innerHTML = '<span class="badge__dot" aria-hidden="true"></span>Online';
              }
            } else {
              card.hidden = true;
            }
          });

          if (grid) {
            data.domains.forEach(function (entry) {
              if (entry.status && entry.status !== "live") return;
              var key = entry.url.replace(/\/+$/, "").toLowerCase();
              var existing = Array.prototype.find.call(
                grid.querySelectorAll("[data-mirror-card]"),
                function (el) {
                  return (
                    (el.getAttribute("data-url") || "").replace(/\/+$/, "").toLowerCase() ===
                    key
                  );
                }
              );
              if (existing) {
                existing.hidden = false;
                return;
              }
              var host = entry.url.replace(/^https?:\/\//, "").replace(/\/+$/, "");
              var a = document.createElement("a");
              a.className = "mirror-card is-live";
              a.href = entry.url;
              a.target = "_blank";
              a.rel = "noopener noreferrer";
              a.setAttribute("data-mirror-card", "");
              a.setAttribute("data-url", entry.url);
              a.innerHTML =
                '<p class="mirror-card__host"></p>' +
                '<span class="badge badge--live" data-status-badge>' +
                '<span class="badge__dot"></span>Online</span>';
              a.querySelector(".mirror-card__host").textContent = host;
              live++;
              if (!firstLive) firstLive = entry.url;
              grid.appendChild(a);
            });
          }

          if (primary) {
            if (firstLive) {
              primary.href = firstLive;
              primary.hidden = false;
            } else {
              primary.removeAttribute("href");
              primary.hidden = true;
            }
          }

          var visibleCards = grid
            ? Array.prototype.filter.call(
                grid.querySelectorAll("[data-mirror-card]"),
                function (el) {
                  return !el.hidden;
                }
              )
            : [];

          var primaryKey = firstLive
            ? firstLive.replace(/\/+$/, "").toLowerCase()
            : "";
          var backupCount = visibleCards.filter(function (el) {
            var key = (el.getAttribute("data-url") || "")
              .replace(/\/+$/, "")
              .toLowerCase();
            return key !== primaryKey;
          }).length;

          if (backup) backup.hidden = backupCount < 1;
          if (empty) empty.hidden = live > 0;
          if (grid) grid.hidden = visibleCards.length === 0;

          document.querySelectorAll("[data-updated-at]").forEach(function (el) {
            if (checkedLabel) {
              el.textContent =
                (el.getAttribute("data-updated-prefix") || "") + checkedLabel;
            }
          });
        }

        fetch("/status.json", { cache: "no-store" })
          .then(function (r) {
            if (!r.ok) throw new Error("bad status");
            return r.json();
          })
          .then(applyStatus)
          .catch(function () {
            var el = document.getElementById("status-data");
            if (el) {
              try {
                applyStatus(JSON.parse(el.textContent || "{}"));
              } catch (e) {}
            }
          });

        if ("serviceWorker" in navigator) {
          window.addEventListener("load", function () {
            navigator.serviceWorker.register("/sw.js").catch(function () {});
          });
        }
      })();
    </script>

    <!-- Histats.com  START  (aync)-->
    <script is:inline type="text/javascript">
      var _Hasync = _Hasync || [];
      _Hasync.push(["Histats.start", "1,5054102,4,0,0,0,00010000"]);
      _Hasync.push(["Histats.fasi", "1"]);
      _Hasync.push(["Histats.track_hits", ""]);
      (function () {
        var hs = document.createElement("script");
        hs.type = "text/javascript";
        hs.async = true;
        hs.src = "//s10.histats.com/js15_as.js";
        (
          document.getElementsByTagName("head")[0] ||
          document.getElementsByTagName("body")[0]
        ).appendChild(hs);
      })();
    </script>
    <noscript>
      <a href="/" target="_blank"
        ><img
          src="//sstatic1.histats.com/0.gif?5054102&101"
          alt="free web hit counter"
          border="0"
        /></a
      >
    </noscript>
    <!-- Histats.com  END  -->
  </body>
</html>

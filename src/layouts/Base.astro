---
import { SITE, formatCheckedAt } from "../data/config";
import { NAV_ITEMS } from "../data/seo";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  path = "/",
} = Astro.props;

const canonical = new URL(path, SITE.url).toString();
const ogImage = new URL("/icons/web-app-manifest-192x192.png", SITE.url).toString();

let statusSnapshot: import("../data/config").StatusSnapshot | null = null;
try {
  const mod = await import("../data/status.json");
  statusSnapshot = (mod.default ?? mod) as import("../data/config").StatusSnapshot;
} catch {
  statusSnapshot = null;
}

const updated = formatCheckedAt(statusSnapshot?.updatedAt);

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE.url}/#website`,
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: "en",
};

const webpageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${SITE.url}/#webpage`,
  url: canonical,
  name: title,
  description,
  isPartOf: { "@id": `${SITE.url}/#website` },
  inLanguage: "en",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(webpageJsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="topbar">
      <div class="container topbar__inner">
        <a class="brand" href="/">GK<span>Streams</span></a>
        <nav class="site-nav" aria-label="Primary">
          {
            NAV_ITEMS.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>{SITE.footerDisclaimer}</p>
        <p class="site-footer__copy">
          © {new Date().getFullYear()} {SITE.name} — directory only. ·
          <span class="updated-at" data-updated-at data-updated-prefix="Updated "
            >Updated {updated}</span
          >
        </p>
      </div>
    </footer>

    <script is:inline type="application/json" id="status-data" set:html={JSON.stringify({
      updatedAt: statusSnapshot?.updatedAt ?? null,
      domains: (statusSnapshot?.domains ?? []).filter((d) => d.status === "live"),
    })} />

    <script is:inline>
      (function () {
        var grid = document.querySelector("[data-mirror-grid]");
        var empty = document.querySelector("[data-empty-state]");
        var introCount = document.querySelectorAll("[data-live-count]");

        function formatTime(iso) {
          if (!iso) return "";
          var t = Date.parse(iso);
          if (Number.isNaN(t) || t === 0) return "";
          try {
            return new Date(t).toLocaleString("en-US", {
              month: "short",
              day: "numeric",
              year: "numeric",
              hour: "numeric",
              minute: "2-digit",
              hour12: true,
            });
          } catch (e) {
            return new Date(t).toUTCString();
          }
        }

        function applyStatus(data) {
          if (!data || !Array.isArray(data.domains)) return;
          var map = {};
          data.domains.forEach(function (d) {
            if (d.status && d.status !== "live") return;
            map[(d.url || "").replace(/\/+$/, "").toLowerCase()] = d;
          });

          var live = 0;
          var checkedLabel = formatTime(data.updatedAt);
          var cards = grid ? grid.querySelectorAll("[data-mirror-card]") : [];

          cards.forEach(function (card) {
            var url = (card.getAttribute("data-url") || "").replace(/\/+$/, "").toLowerCase();
            var entry = map[url];
            if (entry) {
              live++;
              card.hidden = false;
              var badge = card.querySelector("[data-status-badge]");
              if (badge) {
                badge.className = "badge badge--live";
                badge.innerHTML = '<span class="badge__dot" aria-hidden="true"></span>Online';
              }
              var meta = card.querySelector("[data-status-meta]");
              if (meta) {
                var bits = [];
                if (entry.ms != null) bits.push(entry.ms + " ms");
                if (checkedLabel) bits.push("checked " + checkedLabel);
                meta.textContent = bits.join(" · ");
              }
            } else {
              card.hidden = true;
            }
          });

          if (grid) {
            data.domains.forEach(function (entry) {
              if (entry.status && entry.status !== "live") return;
              var key = entry.url.replace(/\/+$/, "").toLowerCase();
              var existing = Array.prototype.find.call(
                grid.querySelectorAll("[data-mirror-card]"),
                function (el) {
                  return (
                    (el.getAttribute("data-url") || "").replace(/\/+$/, "").toLowerCase() ===
                    key
                  );
                }
              );
              if (existing) {
                existing.hidden = false;
                return;
              }
              var host = entry.url.replace(/^https?:\/\//, "").replace(/\/+$/, "");
              var a = document.createElement("a");
              a.className = "mirror-card is-live";
              a.href = entry.url;
              a.target = "_blank";
              a.rel = "noopener noreferrer";
              a.setAttribute("data-mirror-card", "");
              a.setAttribute("data-url", entry.url);
              a.innerHTML =
                '<div><p class="mirror-card__host"></p>' +
                '<span class="mirror-card__meta" data-status-meta></span></div>' +
                '<span class="badge badge--live" data-status-badge>' +
                '<span class="badge__dot"></span>Online</span>';
              a.querySelector(".mirror-card__host").textContent = host;
              var bits = [];
              if (entry.ms != null) bits.push(entry.ms + " ms");
              if (checkedLabel) bits.push("checked " + checkedLabel);
              a.querySelector("[data-status-meta]").textContent = bits.join(" · ");
              live++;
              grid.appendChild(a);
            });
          }

          if (empty) empty.hidden = live > 0;
          if (grid) grid.hidden = live === 0;

          introCount.forEach(function (el) {
            el.textContent = String(live);
          });

          document.querySelectorAll("[data-updated-at]").forEach(function (el) {
            if (checkedLabel) {
              el.textContent =
                (el.getAttribute("data-updated-prefix") || "") + checkedLabel;
            }
          });
        }

        fetch("/status.json", { cache: "no-store" })
          .then(function (r) {
            if (!r.ok) throw new Error("bad status");
            return r.json();
          })
          .then(applyStatus)
          .catch(function () {
            var el = document.getElementById("status-data");
            if (el) {
              try {
                applyStatus(JSON.parse(el.textContent || "{}"));
              } catch (e) {}
            }
          });
      })();
    </script>
  </body>
</html>

---
import { SITE, DOMAINS, formatCheckedAt } from "../data/config";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  path = "/",
} = Astro.props;

const canonical = new URL(path, SITE.url).toString();
const ogImage = new URL("/icons/web-app-manifest-192x192.png", SITE.url).toString();

let statusSnapshot: import("../data/config").StatusSnapshot | null = null;
try {
  const mod = await import("../data/status.json");
  statusSnapshot = (mod.default ?? mod) as import("../data/config").StatusSnapshot;
} catch {
  statusSnapshot = null;
}

const liveDomains = DOMAINS.filter((d) => {
  const key = d.url.replace(/\/+$/, "").toLowerCase();
  const entry = statusSnapshot?.domains?.find(
    (x) => x.url.replace(/\/+$/, "").toLowerCase() === key
  );
  return entry?.status === "live";
});

const liveCount = liveDomains.length;
const updated = formatCheckedAt(statusSnapshot?.updatedAt);

const pillClass =
  liveCount > 0
    ? "status-pill is-live"
    : statusSnapshot?.updatedAt && statusSnapshot.updatedAt !== new Date(0).toISOString()
      ? "status-pill is-down"
      : "status-pill";

const pillLabel =
  liveCount > 0
    ? `${liveCount} online`
    : statusSnapshot?.updatedAt && statusSnapshot.updatedAt !== new Date(0).toISOString()
      ? "checking…"
      : "checking…";

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is GKStreams down right now?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "This page only lists mirror domains that are currently online. If you see mirrors here, they passed our last automated check. Checks run every 5 minutes.",
      },
    },
    {
      "@type": "Question",
      name: "What is a GKStreams mirror?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "A mirror is an alternate address for the same service. This site is an informational directory of those addresses only — it does not host streams, embeds, or media.",
      },
    },
    {
      "@type": "Question",
      name: "How often is the mirror list updated?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Automated checks run every 5 minutes. Domains that are down are removed from this list until they recover.",
      },
    },
    {
      "@type": "Question",
      name: "Does this website host sports streams?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. This is an informational landing page only. It does not host, store, embed, or provide any media, streams, or broadcasts. It only links to third-party destinations.",
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#e10600" />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href="/">
          <img class="brand__logo" src="/logo.svg" width="36" height="36" alt="GKStreams logo" />
          <span class="brand__text">GK<span>Streams</span></span>
        </a>

        <nav class="nav" aria-label="Primary">
          <a href="/#mirrors" aria-current={path === "/" ? "page" : undefined}>Mirrors</a>
          <a href="/#faq">FAQ</a>
          <a href="/disclaimer/" aria-current={path === "/disclaimer/" ? "page" : undefined}>Disclaimer</a>
          <a href="/privacy/" aria-current={path === "/privacy/" ? "page" : undefined}>Privacy</a>
        </nav>

        <div class={pillClass} data-live-pill data-live={String(liveCount)}>
          <span class="status-pill__dot" aria-hidden="true"></span>
          <span data-live-label>{pillLabel}</span>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="site-footer__grid">
          <div>
            <div class="footer-brand">
              <img src="/logo.svg" width="40" height="40" alt="" />
              <strong>GKStreams Mirrors</strong>
            </div>
            <p class="footer-disclaimer">{SITE.footerDisclaimer}</p>
          </div>

          <div>
            <h3>Navigate</h3>
            <ul>
              <li><a href="/#mirrors">Mirror list</a></li>
              <li><a href="/#faq">FAQ</a></li>
              <li><a href="/disclaimer/">Disclaimer &amp; DMCA</a></li>
              <li><a href="/privacy/">Privacy policy</a></li>
            </ul>
          </div>

          <div>
            <h3>Contact</h3>
            <ul>
              <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
              <li><span style="color:var(--text-muted)">Status checked every 5 minutes</span></li>
              <li>
                <span class="updated-at" data-updated-at>{updated}</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="site-footer__bottom">
          <span>© {new Date().getFullYear()} {SITE.name}. Directory page only — no content hosted.</span>
          <span>Last status update: <span class="updated-at" data-updated-at>{updated}</span></span>
        </div>
      </div>
    </footer>

    <script is:inline type="application/json" id="status-data" set:html={JSON.stringify({
      updatedAt: statusSnapshot?.updatedAt ?? null,
      domains: (statusSnapshot?.domains ?? []).filter((d) => d.status === "live"),
    })} />

    <script is:inline>
      (function () {
        var pill = document.querySelector("[data-live-pill]");
        var label = document.querySelector("[data-live-label]");
        var grid = document.querySelector("[data-mirror-grid]");
        var empty = document.querySelector("[data-empty-state]");
        var heroCount = document.querySelectorAll("[data-live-count]");

        function applyStatus(data) {
          if (!data || !Array.isArray(data.domains)) return;
          var map = {};
          data.domains.forEach(function (d) {
            if (d.status && d.status !== "live") return;
            map[(d.url || "").replace(/\/+$/, "").toLowerCase()] = d;
          });

          var live = 0;
          var cards = grid ? grid.querySelectorAll("[data-mirror-card]") : [];

          cards.forEach(function (card) {
            var url = (card.getAttribute("data-url") || "").replace(/\/+$/, "").toLowerCase();
            var entry = map[url];
            if (entry) {
              live++;
              card.hidden = false;
              card.classList.add("is-live");
              var badge = card.querySelector("[data-status-badge]");
              if (badge) {
                badge.className = "badge badge--live";
                badge.innerHTML = '<span class="badge__dot" aria-hidden="true"></span>Online';
              }
              var meta = card.querySelector("[data-status-meta]");
              if (meta) {
                var bits = [];
                if (entry.ms != null) bits.push(entry.ms + " ms");
                if (data.updatedAt) bits.push("checked " + data.updatedAt);
                meta.textContent = bits.join(" · ");
              }
              var btn = card.querySelector("[data-visit]");
              if (btn) btn.classList.remove("is-disabled");
            } else {
              card.hidden = true;
            }
          });

          if (grid) {
            data.domains.forEach(function (entry) {
              if (entry.status && entry.status !== "live") return;
              var key = entry.url.replace(/\/+$/, "").toLowerCase();
              var existing = Array.prototype.find.call(
                grid.querySelectorAll("[data-mirror-card]"),
                function (el) {
                  return (el.getAttribute("data-url") || "").replace(/\/+$/, "").toLowerCase() === key;
                }
              );
              if (existing) {
                existing.hidden = false;
                return;
              }
              var host = entry.url.replace(/^https?:\/\//, "").replace(/\/+$/, "");
              var article = document.createElement("article");
              article.className = "mirror-card is-live";
              article.setAttribute("data-mirror-card", "");
              article.setAttribute("data-url", entry.url);
              article.innerHTML =
                '<div><p class="mirror-card__label">Mirror</p>' +
                '<p class="mirror-card__host"></p></div>' +
                '<div class="mirror-card__actions">' +
                '<span class="badge badge--live" data-status-badge><span class="badge__dot"></span>Online</span>' +
                '<a class="btn btn--primary" data-visit target="_blank" rel="noopener noreferrer">Open mirror ↗</a>' +
                "</div>" +
                '<div class="mirror-card__meta" data-status-meta></div>';
              article.querySelector(".mirror-card__host").textContent = host;
              article.querySelector("[data-visit]").href = entry.url;
              var bits = [];
              if (entry.ms != null) bits.push(entry.ms + " ms");
              if (data.updatedAt) bits.push("checked " + data.updatedAt);
              article.querySelector("[data-status-meta]").textContent = bits.join(" · ");
              live++;
              grid.appendChild(article);
            });
          }

          if (empty) empty.hidden = live > 0;
          if (grid) grid.hidden = live === 0;

          if (pill && label) {
            pill.classList.remove("is-live", "is-down", "is-degraded");
            if (live > 0) pill.classList.add("is-live");
            else pill.classList.add("is-down");
            label.textContent = live > 0 ? live + " online" : "checking…";
          }

          heroCount.forEach(function (el) {
            el.textContent = String(live);
          });

          document.querySelectorAll("[data-updated-at]").forEach(function (el) {
            if (data.updatedAt) el.textContent = data.updatedAt;
          });
        }

        fetch("/status.json", { cache: "no-store" })
          .then(function (r) {
            if (!r.ok) throw new Error("bad status");
            return r.json();
          })
          .then(applyStatus)
          .catch(function () {
            var el = document.getElementById("status-data");
            if (el) {
              try {
                applyStatus(JSON.parse(el.textContent || "{}"));
              } catch (e) {}
            }
          });
      })();
    </script>
  </body>
</html>
